--========================================================--
-- TABLE TO TRACK PROCESSED CHARACTERS
--========================================================--

local processedCharacters = {}

--========================================================--
-- PLAY RANDOM DEATH SOUND
--========================================================--

local function playDeathSound()
	if #deathsounds == 0 then
		warn("DiedScript: No death sounds available.")
		return
	end

	local data = deathsounds[math.random(1, #deathsounds)]

	if not data then
		return
	end

	-- data:
	-- [1] SoundId
	-- [2] TimePosition
	-- [3] Volume
	-- [4] PlaybackSpeed

	local sound = Instance.new("Sound")

	sound.SoundId = data[1]
	sound.TimePosition = data[2] or 0
	sound.Volume = data[3] or 4
	sound.PlaybackSpeed = data[4] or 1

	sound.Parent = SoundService

	sound:Play()

	-- Your original 5-second cutoff.
	task.delay(5, function()
		if sound and sound.Parent and sound.Playing then
			sound:Stop()
		end

		if sound and sound.Parent then
			sound:Destroy()
		end
	end)

	-- Clean up normally if the sound ends before 5 seconds.
	sound.Ended:Once(function()
		if sound and sound.Parent then
			sound:Destroy()
		end
	end)
end

--========================================================--
-- CHARACTER PROCESSING
--========================================================--

local function processCharacter(character)

	local humanoid = character

	if not humanoid then
		return
	end

	processedCharacters[character] = true

	local diedConnection

	diedConnection = humanoid.Died:Connect(function()
		playDeathSound()
	end)

	--====================================================--
	-- CLEANUP
	--====================================================--

	local destroyingConnection

	destroyingConnection = character.Destroying:Connect(function()

		if diedConnection then
			diedConnection:Disconnect()
			diedConnection = nil
		end

		if destroyingConnection then
			destroyingConnection:Disconnect()
			destroyingConnection = nil
		end

		processedCharacters[character] = nil
	end)
end

--========================================================--
-- CHARACTER DETECTION
--========================================================--

local function scanAndProcessCharacter(instance)

	if instance:IsA("Humanoid") then

		task.spawn(
			processCharacter,
			instance
		)
	end
end

-- Existing characters
for _, child in Workspace:GetDescendants() do
	scanAndProcessCharacter(child)
end

