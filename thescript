--===========================================================
-- UTILITY
--===========================================================

local function debugPrint(...)
	if DEBUG then
		print("[DeathSystem DEBUG]", ...)
	end
end

local function randomEntry(list)
	if not list or #list == 0 then
		return ""
	end

	return list[math.random(1, #list)]
end

local function printMessage(message)

	if not message or message == "" then
		return
	end

	if AVOID_DUPLICATES and message == lastMessage then
		return
	end

	lastMessage = message

	print(message)
	pcall(function()
		game:FindFirstChild("TextChatService"):FindFirstChild("TextChannels"):FindFirstChild("RBXGeneral"):DisplaySystemMessage(message)
	end)
end

--===========================================================
-- DEATH CAUSE
--===========================================================

local function getDeathCause(humanoid)

	if not humanoid then
		return "Unknown"
	end

	local state = humanoid:GetState()

	if state == Enum.HumanoidStateType.Freefall then
		return "Falling"

	elseif state == Enum.HumanoidStateType.FallingDown then
		return "Falling"

	elseif state == Enum.HumanoidStateType.Flying then
		return "Flying"

	elseif state == Enum.HumanoidStateType.Swimming then
		return "Swimming"

	elseif state == Enum.HumanoidStateType.Seated then
		return "Seated"

	elseif state == Enum.HumanoidStateType.PlatformStanding then
		return "Platform"
	end

	return "Unknown"
end

--===========================================================
-- MULTI DEATH DETECTION
--===========================================================

local function registerDeath(characterName)

	local now = os.clock()

	table.insert(
		recentDeaths,
		{
			Name = characterName,
			Time = now
		}
	)

	for i = #recentDeaths, 1, -1 do

		if now - recentDeaths[i].Time > MULTIKILL_WINDOW then
			table.remove(recentDeaths, i)
		end

	end

	return #recentDeaths
end

--===========================================================
-- DEATH HANDLER
--===========================================================

local function handleDeath(character, humanoid)

	if not character or not humanoid then
		return
	end

	deathCount += 1

	local name = character.Name

	-- Randomly select normal/rare message.

	local message

	if math.random() <= RARE_MESSAGE_CHANCE then
		message = randomEntry(rareDeathMessages)
	else
		message = randomEntry(deathMessages)
	end

	message = name .. " " .. message

	-- Sometimes append the last known Humanoid state.

	local cause = getDeathCause(humanoid)

	if cause ~= "Unknown" and math.random() <= 0.35 then
		message = message .. " Cause: " .. cause .. "."
	end

	printMessage(
		"<b><font color='#FF0000'>[DEATH]:</font></b> " .. message
	)

	-- Local player's death.

	local player = Players:GetPlayerFromCharacter(character)

	if player == Players.LocalPlayer then

		localDeathCount += 1

		printMessage(
			"<b><font color='#FF0000'>[DEATH]:</font></b> Your death count is now "
				.. localDeathCount
				.. "."
		)

	end

	-- Multi-death nonsense.

	local recentCount = registerDeath(name)

	if recentCount >= 2 then

		printMessage(
			"<b><font color='rgb(0, 0, 255)'>[STREAK]:</font></b> "
				.. recentCount
				.. " deaths have occurred within "
				.. MULTIKILL_WINDOW
				.. " seconds."
		)

	end

	-- Rare system nonsense.

	if math.random() <= RARE_MESSAGE_CHANCE then

		printMessage(
			"<b><font color='rgb(100, 100, 100)'>[SYSTEM]:</font></b> "
				.. randomEntry(systemMessages)
		)

	end

	debugPrint(
		"Death:",
		name,
		"Cause:",
		cause
	)

end

--===========================================================
-- CHARACTER HANDLING
--===========================================================

local function handleCharacter(character)

	if not character then
		return
	end

	if not character:IsA("Model") then
		return
	end

	if processedCharacters[character] then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	processedCharacters[character] = true

	local deathConnection

	deathConnection = humanoid.Died:Connect(function()

		handleDeath(
			character,
			humanoid
		)

		if deathConnection then
			deathConnection:Disconnect()
			deathConnection = nil
		end

	end)

	-- Cleanup.

	character.AncestryChanged:Connect(function(_, parent)

		if not parent then
			processedCharacters[character] = nil
		end

	end)

end

--===========================================================
-- INITIAL SCAN
--===========================================================

for _, descendant in ipairs(
	Workspace:GetDescendants()
	) do

	if descendant:IsA("Humanoid") then

		task.defer(
			handleCharacter,
			descendant.Parent
		)

	end

end

