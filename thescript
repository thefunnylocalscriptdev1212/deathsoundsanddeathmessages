local availableSounds = table.clone(deathsounds)

--========================================================--
-- PLAY RANDOM SOUND
--========================================================--

local function PlayRandomSound()

	if #deathsounds == 0 then
		warn("JoinAndLeaveScript: No sounds available.")
		return
	end

	-- Refill once every sound has been used.
	if #availableSounds == 0 then
		availableSounds = table.clone(deathsounds)
	end

	-- Pick one from the remaining bag.
	local randomIndex =
		math.random(1, #availableSounds)

	local data =
		availableSounds[randomIndex]

	-- Remove it from the bag.
	table.remove(
		availableSounds,
		randomIndex
	)

	if not data then
		return
	end

	--====================================================--
	-- CREATE THE SOUND
	--====================================================--

	local sound = Instance.new("Sound")

	sound.SoundId = data[1]
	sound.TimePosition = data[2] or 0
	sound.Volume = data[3] or 4
	sound.PlaybackSpeed = data[4] or 1

	-- SoundService makes this global for the server/client
	-- depending on where this script is running.
	sound.Parent = SoundService

	sound:Play()

	-- Clean it up when finished.
	sound.Ended:Once(function()
		if sound and sound.Parent then
			sound:Destroy()
		end
	end)

	-- Safety cleanup for weird/stuck audio.
	task.delay(15, function()
		if sound and sound.Parent then
			sound:Destroy()
		end
	end)
end

--========================================================--
-- PLAYER JOIN / LEAVE
--========================================================--

Players.PlayerAdded:Connect(function(player)
	PlayRandomSound()
end)

Players.PlayerRemoving:Connect(function(player)
	PlayRandomSound()
end)

